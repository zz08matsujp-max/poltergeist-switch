{
    "name": "poltergeist-switch/house-rules-engine",
    "description": "PoltergeistSwitch house rules engine",
    "type": "library",
    "license": "Apache-2.0",
    "require": {},
    "require-dev": {
        "phpunit/phpunit": "^11",
        "giorgiosironi/eris": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "PoltergeistSwitch\\Engine\\": "src/Engine/",
            "PoltergeistSwitch\\TurnLoop\\": "src/TurnLoop/",
            "PoltergeistSwitch\\Memory\\": "src/Memory/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PoltergeistSwitch\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
